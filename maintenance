local function createSparkle(position, size)
	local holder = Instance.new("Frame")
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = position
	holder.Size = UDim2.fromOffset(size, size)
	holder.BackgroundTransparency = 1
	holder.ZIndex = 3
	holder.Rotation = rng:NextNumber(-20, 20)
	holder.Parent = wrapper
	local scale = Instance.new("UIScale")
	scale.Scale = 0
	scale.Parent = holder
	local function makeArm(vertical)
		local arm = Instance.new("Frame")
		arm.AnchorPoint = Vector2.new(0.5, 0.5)
		arm.Position = UDim2.fromScale(0.5, 0.5)
		arm.Size = vertical and UDim2.new(0, math.max(2, size * 0.16), 1, 0)
			or UDim2.new(1, 0, 0, math.max(2, size * 0.16))
		arm.BackgroundColor3 = Color3.fromRGB(255, 232, 243)
		arm.BackgroundTransparency = 0.1
		arm.BorderSizePixel = 0
		arm.ZIndex = 3
		arm.Parent = holder
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = arm
	end
	makeArm(true)
	makeArm(false)
	table.insert(sparkles, scale)
	return scale
end
