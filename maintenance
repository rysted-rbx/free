petalConnection = RunService.RenderStepped:Connect(function(dt)
	for _, data in ipairs(petals) do
		data.y += data.fall * dt
		data.phase += data.swaySpeed * dt
		data.rotation += data.spin * dt
		if data.y > 1.15 then
			data.y = rng:NextNumber(-0.3, -0.05)
			data.x = rng:NextNumber(-0.05, 1.05)
			data.spin = rng:NextNumber(-55, 55)
		end
		local swayX = math.sin(data.phase) * data.sway
		data.frame.Position = UDim2.fromScale(data.x + swayX, data.y)
		data.frame.Rotation = data.rotation + math.sin(data.phase * 1.6) * 18
	end
end)
