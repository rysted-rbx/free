local function spawnPetal(parent, width, transparency, atTop)
	local petal = Instance.new("Frame")
	petal.AnchorPoint = Vector2.new(0.5, 0.5)
	petal.Size = UDim2.fromOffset(width, math.floor(width * 0.62))
	petal.BackgroundColor3 = PETAL_COLORS[rng:NextInteger(1, #PETAL_COLORS)]
	petal.BackgroundTransparency = 1
	petal.BorderSizePixel = 0
	petal.ZIndex = parent.ZIndex
	petal.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = petal
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 35
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 0.55),
	})
	gradient.Parent = petal
	local data = {
		frame = petal,
		x = rng:NextNumber(-0.05, 1.05),
		y = atTop and rng:NextNumber(-0.25, -0.02) or rng:NextNumber(-0.2, 1),
		fall = rng:NextNumber(0.035, 0.085),
		sway = rng:NextNumber(0.012, 0.038),
		swaySpeed = rng:NextNumber(0.5, 1.4),
		spin = rng:NextNumber(-55, 55),
		phase = rng:NextNumber(0, math.pi * 2),
		rotation = rng:NextNumber(0, 360),
		transparency = transparency,
	}
	table.insert(petals, data)
	TweenService:Create(petal, TweenInfo.new(1.2, Enum.EasingStyle.Quad), {
		BackgroundTransparency = transparency,
	}):Play()
	return data
end
