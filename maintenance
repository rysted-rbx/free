			task.wait(0.55)
			if closing then
				break
			end
			TweenService
				:Create(scale, TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 })
				:Play()
			task.wait(0.38 + rng:NextNumber(0.6, 2.4))
		end
	end)
end
